# Shell and terminal tools used on every machine.
tap "hashicorp/tap"

brew "ansible"
brew "ansible-lint"
brew "atuin"
brew "bat"
brew "btop"
brew "cmake"
brew "curl"
brew "direnv"
brew "dos2unix"
brew "eza"
brew "fd"
brew "fzf"
brew "gcc"
brew "gh"
brew "git"
brew "gnupg"
brew "htop"
brew "hashicorp/tap/packer"
brew "hashicorp/tap/terraform"
brew "iperf3"
brew "jq"
brew "mtr"
brew "ncdu"
brew "nmap"
brew "node"
brew "openjdk"
brew "pipx"
brew "python"
brew "ripgrep"
brew "shellcheck"
brew "stow"
brew "tig"
brew "tldr"
brew "tmux"
brew "tree"
brew "wget"
brew "yq"
brew "zoxide"
brew "zsh"

# Graphical terminal and fonts used by the managed configurations.
cask "ghostty" if OS.mac?
cask "font-hack" if OS.mac?
cask "font-source-code-pro" if OS.mac?
cask "font-terminus" if OS.mac?
cask "docker" if OS.mac?
cask "meld" if OS.mac?
cask "slack" if OS.mac?
cask "visual-studio-code" if OS.mac?

flatpak "com.slack.Slack", remote: "flathub" if OS.linux?
flatpak "com.visualstudio.code", remote: "flathub" if OS.linux?
flatpak "org.gnome.meld", remote: "flathub" if OS.linux?
