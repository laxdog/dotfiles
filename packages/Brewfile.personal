# Media utilities.
brew "ffmpeg"
brew "sevenzip"
brew "yt-dlp"

# Desktop applications.
cask "brave-browser" if OS.mac?
cask "discord" if OS.mac?
cask "firefox" if OS.mac?
cask "gimp" if OS.mac?
cask "signal" if OS.mac?
cask "spotify" if OS.mac?
cask "steam" if OS.mac?
cask "vlc" if OS.mac?
cask "whatsapp" if OS.mac?
cask "mixxx" if OS.mac?

flatpak "com.brave.Browser", remote: "flathub" if OS.linux?
flatpak "com.discordapp.Discord", remote: "flathub" if OS.linux?
flatpak "org.mozilla.firefox", remote: "flathub" if OS.linux?
flatpak "org.gimp.GIMP", remote: "flathub" if OS.linux?
flatpak "org.signal.Signal", remote: "flathub" if OS.linux?
flatpak "com.spotify.Client", remote: "flathub" if OS.linux?
flatpak "com.valvesoftware.Steam", remote: "flathub" if OS.linux?
flatpak "org.videolan.VLC", remote: "flathub" if OS.linux?
flatpak "org.mixxx.Mixxx", remote: "flathub" if OS.linux?
