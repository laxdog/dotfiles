# Media utilities.
brew "ffmpeg" if OS.linux?
brew "sevenzip" if OS.linux?
brew "yt-dlp" if OS.linux?

# Desktop applications on Ubuntu.
flatpak "com.brave.Browser", remote: "flathub" if OS.linux?
flatpak "com.bitwarden.desktop", remote: "flathub" if OS.linux?
flatpak "com.github.IsmaelMartinez.teams_for_linux", remote: "flathub" if OS.linux?
flatpak "com.github.iwalton3.jellyfin-media-player", remote: "flathub" if OS.linux?
flatpak "com.mastermindzh.tidal-hifi", remote: "flathub" if OS.linux?
flatpak "com.rtosta.zapzap", remote: "flathub" if OS.linux?
flatpak "md.obsidian.Obsidian", remote: "flathub" if OS.linux?
flatpak "org.mozilla.firefox", remote: "flathub" if OS.linux?
flatpak "org.signal.Signal", remote: "flathub" if OS.linux?
flatpak "com.valvesoftware.Steam", remote: "flathub" if OS.linux?
flatpak "org.telegram.desktop", remote: "flathub" if OS.linux?
