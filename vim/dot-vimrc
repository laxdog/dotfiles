set nocompatible

let mapleader = "1"

filetype plugin indent on
syntax enable

set autochdir
set backspace=indent,eol,start
set background=dark
set cmdheight=1
set cursorcolumn
set cursorline
set expandtab
set foldlevel=99
set foldmethod=indent
set hidden
set hlsearch
set ignorecase
set lazyredraw
set regexpengine=1
set scrolloff=7
set shiftwidth=4
set showmatch
set sidescrolloff=5
set smartcase
set softtabstop=4
set splitbelow
set splitright
set tabstop=4
set ttyfast
set wildmenu
if exists('+t_Co')
  set t_Co=256
endif

nnoremap <space> za
nnoremap <leader>1 :NERDTreeTabsToggle<CR>
nnoremap <leader>2 :NERDTreeFocusToggle<CR>
nnoremap <leader>3 :TagbarToggle<CR>
nnoremap <leader>4 :set number!<CR>
nnoremap <leader>5 :set paste!<CR>
nnoremap <leader>6 :SyntasticToggleMode<CR>
nnoremap <leader>7 :if exists("syntax_on") \| syntax off \| else \| syntax on \| endif<CR>
nnoremap <leader>8 :%!indent<CR>
nnoremap <leader>9 :set wrap!<CR>
nnoremap <leader>0 :BufExplorerHorizontalSplit<CR>
nnoremap <leader><Right> :tabnext<CR>
nnoremap <leader><Left> :tabprevious<CR>
nnoremap <F8> :setlocal noautoindent nocindent nosmartindent indentexpr=<CR>
set pastetoggle=<F2>

let g:rainbow_active = 1
let g:nerdtree_tabs_open_on_console_startup = 0
let NERDTreeIgnore = ['\.pyc$', '\~$']

let g:syntastic_always_populate_loc_list = 1
let g:syntastic_auto_loc_list = 0
let g:syntastic_disabled_filetypes = ['html']
let g:syntastic_enable_signs = 1
let g:syntastic_loc_list_height = 3
let g:syntastic_check_on_open = 1
let g:syntastic_check_on_wq = 1
let g:syntastic_error_symbol = '✗✗'
let g:syntastic_warning_symbol = '⚠'
let g:syntastic_style_error_symbol = '≈≈'
let g:syntastic_style_warning_symbol = '✠'
let g:syntastic_enable_balloons = 1
let g:syntastic_python_checkers = ['flake8']
let g:syntastic_python_flake8_args = '--ignore=E401,E221,E241,E702 --max-line-length=120'
let g:syntastic_javascript_checkers = ['jshint']
let g:syntastic_filetype_map = {'json': 'javascript'}
set statusline+=%#warningmsg#
set statusline+=%{exists('*SyntasticStatuslineFlag')?SyntasticStatuslineFlag():''}
set statusline+=%*

let g:airline_powerline_fonts = 1
let g:airline#extensions#tabline#enabled = 1
let g:airline_theme = 'jellybeans'
let g:airline_highlighting_cache = 1

let g:indent_guides_enable_on_vim_startup = 1
let g:indent_guides_start_level = 1
let g:indent_guides_guide_size = 4
let g:indent_guides_auto_colors = 0

if &diff
  set diffopt+=iwhite
endif

function! MarkWindowSwap() abort
  let g:markedWinNum = winnr()
  let g:markedBufNum = bufnr('%')
endfunction

function! DoWindowSwap() abort
  let l:current_window = winnr()
  let l:current_buffer = bufnr('%')
  execute g:markedWinNum . 'wincmd w'
  execute 'hide buffer' l:current_buffer
  execute l:current_window . 'wincmd w'
  execute 'hide buffer' g:markedBufNum
endfunction

nnoremap <leader>h :call MarkWindowSwap()<CR><C-w>h:call DoWindowSwap()<CR>
nnoremap <leader>j :call MarkWindowSwap()<CR><C-w>j:call DoWindowSwap()<CR>
nnoremap <leader>k :call MarkWindowSwap()<CR><C-w>k:call DoWindowSwap()<CR>
nnoremap <leader>l :call MarkWindowSwap()<CR><C-w>l:call DoWindowSwap()<CR>

nnoremap <leader>b Oimport ipdb; ipdb.set_trace()<Esc>
nnoremap <leader>B :g/^\s*import ipdb; ipdb.set_trace()/d<CR>

highlight BadWhitespace ctermbg=red guibg=darkred

augroup dotfiles
  autocmd!
  autocmd VimEnter * silent! colorscheme dracula
  autocmd VimEnter * if exists(':Tagbar') | call tagbar#autoopen(1) | endif
  autocmd VimEnter,Colorscheme * highlight IndentGuidesOdd guibg=red ctermbg=30
  autocmd VimEnter,Colorscheme * highlight IndentGuidesEven guibg=green ctermbg=black
  autocmd BufNewFile,BufRead *.py setlocal softtabstop=4 textwidth=119 fileformat=unix tabstop=4 shiftwidth=4 expandtab filetype=python number
  autocmd BufNewFile,BufRead *.py match BadWhitespace /\s\+$/
augroup END
